{
  "document": {
    "type": "APL",
    "version": "2022.2",
    "extensions": [
      {
        "name": "DataStore",
        "uri": "alexaext:datastore:10"
      }
    ],
    "settings": {
      "DataStore": {
        "dataBindings": [
          {
            "namespace": "MiSolar",
            "key": "Indicadores",
            "dataBindingName": "MiSolarData",
            "dataType": "OBJECT"
          }
        ]
      }
    },
