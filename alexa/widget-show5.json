{
  "type": "APL",
  "version": "2022.2",
  "extensions": [{"name":"DataStore","uri":"alexaext:datastore:10"}],
  "settings": {"DataStore":{"dataBindings":[{"namespace":"MiSolar","key":"Indicadores","dataBindingName":"MiSolarData","dataType":"OBJECT"}]}},
  "mainTemplate": {"items":[{
    "type":"Frame","width":"100vw","height":"100vh","backgroundColor":"#061521","items":[
      {"type":"Image","source":"https://raw.githubusercontent.com/ecodjamb/Mi-Solar/refs/heads/feature/alexa-mi-solar-widget/public/alexa/mi-solar-widget-background-v3.png","width":"100%","height":"100%","scale":"best-fill","opacity":0.22},
      {"type":"Frame","width":"100%","height":"100%","backgroundColor":"#B8061724"},
      {"type":"Container","width":"100%","height":"100%","direction":"column","paddingLeft":"${viewport.width >= 600 ? '24dp' : '14dp'}","paddingRight":"${viewport.width >= 600 ? '24dp' : '14dp'}","paddingTop":"${viewport.height >= 500 ? '18dp' : '10dp'}","paddingBottom":"${viewport.height >= 500 ? '15dp' : '8dp'}","items":[
        {"type":"Container","direction":"row","alignItems":"center","height":"${viewport.height >= 500 ? '48dp' : '34dp'}","items":[
          {"type":"Image","source":"https://raw.githubusercontent.com/ecodjamb/Mi-Solar/feature/alexa-mi-solar-widget/public/alexa/mi-solar-widget-icon-v1.0.7.png","width":"${viewport.height >= 500 ? '38dp' : '27dp'}","height":"${viewport.height >= 500 ? '38dp' : '27dp'}","borderRadius":"10dp","scale":"best-fill"},
          {"type":"Container","grow":1,"paddingLeft":"10dp","items":[
            {"type":"Text","text":"mi solar","fontSize":"${viewport.height >= 500 ? '23dp' : '17dp'}","fontWeight":"bold","color":"#FFFFFF","maxLines":1},
            {"type":"Text","text":"EL ARRAYÁN · ENERGÍA EN VIVO","fontSize":"${viewport.height >= 500 ? '9dp' : '7dp'}","letterSpacing":"1dp","color":"#B8D5E4","maxLines":1}
          ]},
          {"type":"Container","alignItems":"end","items":[
            {"type":"Text","text":"v1.0.7","fontSize":"${viewport.height >= 500 ? '11dp' : '8dp'}","fontWeight":"bold","color":"#FFE16A","maxLines":1},
            {"type":"Text","text":"${MiSolarData ? '● DS OK' : '● DS VACÍO'}","fontSize":"${viewport.height >= 500 ? '8dp' : '7dp'}","fontWeight":"bold","color":"${MiSolarData ? '#65F4A3' : '#FF8B88'}","maxLines":1}
          ]}
        ]},
        {"type":"Container","direction":"row","height":"${viewport.height >= 500 ? '172dp' : '116dp'}","spacing":"${viewport.width >= 600 ? '14dp' : '8dp'}","items":[
          {"type":"Frame","width":"49%","height":"100%","backgroundColor":"#EB24384A","borderRadius":"20dp","borderWidth":"1dp","borderColor":"#55FFD75A","items":[
