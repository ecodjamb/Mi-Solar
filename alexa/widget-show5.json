{
  "type": "APL",
  "version": "2022.2",
  "extensions": [{ "name": "DataStore", "uri": "alexaext:datastore:10" }],
  "settings": { "DataStore": { "dataBindings": [{ "namespace": "MiSolar", "key": "Indicadores", "dataBindingName": "MiSolarData", "dataType": "OBJECT" }] } },
  "mainTemplate": {
    "items": [{
      "type": "Frame", "width": "100vw", "height": "100vh", "backgroundColor": "#071C30",
      "items": [{
        "type": "Container", "width": "100%", "height": "100%", "direction": "column",
        "paddingLeft": "10dp", "paddingRight": "10dp", "paddingTop": "7dp", "paddingBottom": "7dp",
        "items": [
          {
            "type": "Container", "direction": "row", "alignItems": "center", "height": "26dp",
            "items": [
              { "type": "Image", "source": "https://raw.githubusercontent.com/ecodjamb/Mi-Solar/3a2f6193b3363b756bd00ac325cf1fab7babfaf2/public/alexa/mi-solar-widget-icon.png", "width": "22dp", "height": "22dp", "borderRadius": "6dp", "scale": "best-fill" },
              { "type": "Text", "text": "MI SOLAR · EL ARRAYÁN", "fontSize": "15dp", "fontWeight": "bold", "color": "#FFFFFF", "maxLines": 1, "paddingLeft": "7dp" }
            ]
          },
          {
            "type": "Container", "direction": "row", "height": "64dp", "justifyContent": "spaceBetween",
            "items": [
              { "type": "Frame", "width": "49%", "height": "60dp", "backgroundColor": "#0D3458", "borderRadius": "9dp", "items": [{ "type": "Container", "paddingLeft": "8dp", "paddingTop": "5dp", "items": [
                { "type": "Text", "text": "☀  PANELES · PV1 + PV2", "fontSize": "11dp", "fontWeight": "bold", "color": "#FFD33D", "maxLines": 1 },
                { "type": "Text", "text": "${MiSolarData.generacion ? MiSolarData.generacion : '--'}", "fontSize": "20dp", "fontWeight": "bold", "color": "#FFFFFF", "maxLines": 1 },
                { "type": "Text", "text": "${'Hoy ' + (MiSolarData.generadoHoy ? MiSolarData.generadoHoy : '--')}", "fontSize": "10dp", "color": "#C8D8E5", "maxLines": 1 }
              ]}]},
              { "type": "Frame", "width": "49%", "height": "60dp", "backgroundColor": "#172A52", "borderRadius": "9dp", "items": [{ "type": "Container", "paddingLeft": "8dp", "paddingTop": "7dp", "items": [
                { "type": "Text", "text": "⌂  CASA", "fontSize": "11dp", "fontWeight": "bold", "color": "#C98CFF", "maxLines": 1 },
                { "type": "Text", "text": "${MiSolarData.consumo ? MiSolarData.consumo : '--'}", "fontSize": "20dp", "fontWeight": "bold", "color": "#FFFFFF", "maxLines": 1 }
              ]}]}
            ]
          },
          {
            "type": "Container", "direction": "row", "height": "60dp", "justifyContent": "spaceBetween",
            "items": [
              { "type": "Frame", "width": "49%", "height": "56dp", "backgroundColor": "#123D3B", "borderRadius": "9dp", "items": [{ "type": "Container", "paddingLeft": "8dp", "paddingTop": "7dp", "items": [
                { "type": "Text", "text": "▰  BATERÍA", "fontSize": "11dp", "fontWeight": "bold", "color": "#63E58B", "maxLines": 1 },
                { "type": "Text", "text": "${MiSolarData.bateria ? MiSolarData.bateria : '--'}", "fontSize": "20dp", "fontWeight": "bold", "color": "#FFFFFF", "maxLines": 1 }
              ]}]},
              { "type": "Frame", "width": "49%", "height": "56dp", "backgroundColor": "#103459", "borderRadius": "9dp", "items": [{ "type": "Container", "paddingLeft": "8dp", "paddingTop": "7dp", "items": [
                { "type": "Text", "text": "⌁  RED", "fontSize": "11dp", "fontWeight": "bold", "color": "#62B3FF", "maxLines": 1 },
                { "type": "Text", "text": "${MiSolarData.red ? MiSolarData.red : '--'}", "fontSize": "20dp", "fontWeight": "bold", "color": "#FFFFFF", "maxLines": 1 }
              ]}]}
            ]
          },
          {
            "type": "Frame", "height": "45dp", "backgroundColor": "#0C2B49", "borderRadius": "9dp",
            "items": [{ "type": "Container", "paddingLeft": "8dp", "paddingRight": "8dp", "paddingTop": "4dp", "items": [
              { "type": "Container", "direction": "row", "justifyContent": "spaceBetween", "items": [
                { "type": "Text", "text": "${'GENERADO  ' + (MiSolarData.generadoHoy ? MiSolarData.generadoHoy : '--')}", "fontSize": "10dp", "fontWeight": "bold", "color": "#FFD33D", "maxLines": 1 },
                { "type": "Text", "text": "${'ESPERADO  ' + (MiSolarData.esperadoHoy ? MiSolarData.esperadoHoy : '--')}", "fontSize": "10dp", "color": "#FFFFFF", "maxLines": 1 }
              ]},
              { "type": "Frame", "width": "100%", "height": "8dp", "backgroundColor": "#31577B", "borderRadius": "4dp", "items": [
                { "type": "Frame", "width": "${MiSolarData.progresoSolar ? MiSolarData.progresoSolar : '0%'}", "height": "8dp", "backgroundColor": "#FFD21F", "borderRadius": "4dp" }
              ]}
            ]}]
          },
          { "type": "Text", "text": "${(MiSolarData.estado ? MiSolarData.estado : 'Sin datos') + ' · ' + (MiSolarData.hora ? MiSolarData.hora : '--:--') + ' · ' + (MiSolarData.origen ? MiSolarData.origen : '--')}", "fontSize": "9dp", "color": "#9EB6C8", "textAlign": "center", "maxLines": 1 }
        ]
      }]
    }]
  }
}
