        {"type":"Text","height":"${viewport.height >= 550 ? '19dp' : '13dp'}","text":"${(MiSolarData && MiSolarData.estado ? MiSolarData.estado : 'Sin datos') + ' · muestra ' + (MiSolarData && MiSolarData.hora ? MiSolarData.hora : '--:--') + ' · mi solar v1.0.10'}","fontSize":"${viewport.width >= 350 ? '9dp' : '6dp'}","color":"#AFC5D1","textAlign":"center","textAlignVertical":"center","maxLines":1}
      ]}
