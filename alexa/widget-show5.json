            ]}
          ]}
        ]},
        {"type":"Frame","height":"17%","backgroundColor":"#102631","borderRadius":"${viewport.width >= 350 ? '20dp' : '14dp'}","borderWidth":"1dp","borderColor":"#777AA0B7","items":[
          {"type":"Container","height":"100%","paddingLeft":"${viewport.width >= 600 ? '18dp' : '11dp'}","paddingRight":"${viewport.width >= 600 ? '18dp' : '11dp'}","paddingTop":"${viewport.height >= 500 ? '12dp' : '8dp'}","paddingBottom":"${viewport.height >= 500 ? '10dp' : '7dp'}","justifyContent":"spaceBetween","items":[
            {"type":"Container","direction":"row","justifyContent":"spaceBetween","items":[
              {"type":"Text","text":"${'GENERADO HOY  ' + (MiSolarData && MiSolarData.generadoHoy ? MiSolarData.generadoHoy : '--')}","fontSize":"${viewport.width >= 350 ? '14dp' : viewport.width >= 240 ? '10dp' : '7dp'}","fontWeight":"bold","color":"#FFE16A","maxLines":1},
              {"type":"Text","text":"${MiSolarData && MiSolarData.tienePronostico ? 'ESPERADO  ' + MiSolarData.esperadoHoy : 'ESPERADO  --'}","fontSize":"${viewport.height >= 500 ? '13dp' : '9dp'}","fontWeight":"bold","color":"#FFFFFF","maxLines":1}
            ]},
            {"type":"Frame","width":"100%","height":"${viewport.height >= 500 ? '18dp' : '12dp'}","backgroundColor":"#35536B78","borderRadius":"9dp","items":[{"type":"Frame","width":"${MiSolarData && MiSolarData.progresoSolarValor ? MiSolarData.progresoSolarValor + '%' : '0%'}","height":"100%","backgroundColor":"#FFD84F","borderRadius":"9dp"}]},
            {"type":"Text","text":"${MiSolarData && MiSolarData.tienePronostico ? MiSolarData.progresoSolar + ' de la producción esperada' : 'Pronóstico diario no disponible'}","fontSize":"${viewport.width >= 350 ? '9dp' : '6dp'}","color":"#BBD2DE","maxLines":1}
          ]}
        ]},
        {"type":"Container","direction":"row","height":"7%","alignItems":"center","spacing":"8dp","items":[
          {"type":"Text","grow":1,"text":"${(MiSolarData && MiSolarData.estado ? MiSolarData.estado : 'Sin datos') + ' · ' + (MiSolarData && MiSolarData.hora ? MiSolarData.hora : '--:--') + ' · v1.0.11'}","fontSize":"${viewport.width >= 350 ? '9dp' : '6dp'}","color":"#AFC5D1","textAlign":"left","textAlignVertical":"center","maxLines":1},
          {"type":"TouchWrapper","height":"100%","width":"${viewport.width >= 350 ? '132dp' : viewport.width >= 240 ? '96dp' : '70dp'}","onPress":{"type":"OpenURL","source":"https://misolar.vercel.app/monitor"},"items":[
            {"type":"Frame","height":"100%","width":"100%","backgroundColor":"#123A45","borderRadius":"${viewport.height >= 500 ? '16dp' : '10dp'}","borderWidth":"1dp","borderColor":"#48CFE8","items":[
