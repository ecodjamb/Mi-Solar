          {"type":"Frame","width":"49%","height":"100%","backgroundColor":"#D1092946","borderRadius":"14dp","borderWidth":"1dp","borderColor":"#555DB9FF","items":[{"type":"Container","height":"100%","paddingLeft":"10dp","paddingTop":"${viewport.height >= 500 ? '12dp' : '7dp'}","paddingBottom":"7dp","justifyContent":"spaceBetween","items":[{"type":"Text","text":"⌁  RED ELÉCTRICA","fontSize":"${viewport.height >= 500 ? '11dp' : '9dp'}","fontWeight":"bold","color":"#79C6FF","maxLines":1},{"type":"Text","text":"${MiSolarData.red ? MiSolarData.red : '--'}","fontSize":"${viewport.height >= 500 ? '34dp' : '24dp'}","fontWeight":"bold","color":"#FFFFFF","maxLines":1},{"type":"Text","text":"IMPORTACIÓN ACTUAL","fontSize":"${viewport.height >= 500 ? '9dp' : '7dp'}","color":"#AEC9DD","maxLines":1}]}]}
        ]},
        {"type":"Frame","height":"${viewport.height >= 500 ? '76dp' : '53dp'}","backgroundColor":"#E30A2238","borderRadius":"14dp","borderWidth":"1dp","borderColor":"#446D97B5","items":[{"type":"Container","height":"100%","paddingLeft":"10dp","paddingRight":"10dp","paddingTop":"7dp","paddingBottom":"7dp","justifyContent":"spaceBetween","items":[
