          {"type":"Frame","width":"100%","height":"${viewport.height >= 500 ? '14dp' : '10dp'}","backgroundColor":"#36516B7B","borderRadius":"7dp","items":[{"type":"Frame","width":"${MiSolarData.tienePronostico ? MiSolarData.progresoSolarValor + '%' : '100%'}","height":"100%","backgroundColor":"${MiSolarData.tienePronostico ? '#FFD43B' : '#508DA6B5'}","borderRadius":"7dp"}]},
          {"type":"Text","text":"${MiSolarData.tienePronostico ? MiSolarData.progresoSolar + ' de la meta diaria' : 'Producción real acumulada · meta no informada'}","fontSize":"${viewport.height >= 500 ? '9dp' : '7dp'}","color":"#9FC1D2","maxLines":1}
        ]}]},
        {"type":"Text","height":"${viewport.height >= 500 ? '19dp' : '13dp'}","text":"${(MiSolarData.estado ? MiSolarData.estado : 'Sin datos') + ' · ' + (MiSolarData.hora ? MiSolarData.hora : '--:--') + ' · ' + (MiSolarData.origen ? MiSolarData.origen : '--')}","fontSize":"${viewport.height >= 500 ? '9dp' : '7dp'}","color":"#9EBAC9","textAlign":"center","textAlignVertical":"center","maxLines":1}
      ]}
    ]
  }]}
