              {"type":"Text","text":"${MiSolarData && MiSolarData.generacion ? MiSolarData.generacion : '--'}","fontSize":"${viewport.height >= 500 ? '45dp' : '29dp'}","fontWeight":"bold","color":"#FFFFFF","maxLines":1},
              {"type":"Text","text":"${'HOY  ' + (MiSolarData && MiSolarData.generadoHoy ? MiSolarData.generadoHoy : '--')}","fontSize":"${viewport.height >= 500 ? '13dp' : '9dp'}","fontWeight":"bold","color":"#FFD85B","maxLines":1}
            ]}
          ]},
          {"type":"Frame","width":"49%","height":"100%","backgroundColor":"#EB2B294F","borderRadius":"20dp","borderWidth":"1dp","borderColor":"#557AC8FF","items":[
            {"type":"Container","height":"100%","paddingLeft":"${viewport.width >= 600 ? '18dp' : '11dp'}","paddingRight":"10dp","paddingTop":"${viewport.height >= 500 ? '15dp' : '9dp'}","paddingBottom":"${viewport.height >= 500 ? '13dp' : '8dp'}","justifyContent":"spaceBetween","items":[
              {"type":"Text","text":"⌂  CONSUMO CASA","fontSize":"${viewport.height >= 500 ? '13dp' : '9dp'}","fontWeight":"bold","color":"#E3B5FF","maxLines":1},
              {"type":"Text","text":"${MiSolarData && MiSolarData.consumo ? MiSolarData.consumo : '--'}","fontSize":"${viewport.height >= 500 ? '45dp' : '29dp'}","fontWeight":"bold","color":"#FFFFFF","maxLines":1},
              {"type":"Text","text":"DEMANDA INSTANTÁNEA","fontSize":"${viewport.height >= 500 ? '10dp' : '7dp'}","color":"#C1D3DF","maxLines":1}
            ]}
          ]}
        ]},
        {"type":"Container","direction":"row","height":"${viewport.height >= 500 ? '172dp' : '116dp'}","spacing":"${viewport.width >= 600 ? '14dp' : '8dp'}","items":[
          {"type":"Frame","width":"49%","height":"100%","backgroundColor":"#EB163F39","borderRadius":"20dp","borderWidth":"1dp","borderColor":"#5568F0A0","items":[
            {"type":"Container","height":"100%","paddingLeft":"${viewport.width >= 600 ? '18dp' : '11dp'}","paddingRight":"10dp","paddingTop":"${viewport.height >= 500 ? '15dp' : '9dp'}","paddingBottom":"${viewport.height >= 500 ? '13dp' : '8dp'}","justifyContent":"spaceBetween","items":[
              {"type":"Text","text":"▰  BATERÍA","fontSize":"${viewport.height >= 500 ? '13dp' : '9dp'}","fontWeight":"bold","color":"#72F0A7","maxLines":1},
              {"type":"Text","text":"${MiSolarData && MiSolarData.bateria ? MiSolarData.bateria : '--'}","fontSize":"${viewport.height >= 500 ? '45dp' : '29dp'}","fontWeight":"bold","color":"#FFFFFF","maxLines":1},
              {"type":"Frame","width":"100%","height":"8dp","backgroundColor":"#355C776D","borderRadius":"4dp","items":[{"type":"Frame","width":"${MiSolarData && MiSolarData.bateriaValor ? MiSolarData.bateriaValor + '%' : '0%'}","height":"100%","backgroundColor":"#68ECA0","borderRadius":"4dp"}]}
            ]}
          ]},
          {"type":"Frame","width":"49%","height":"100%","backgroundColor":"#EB173650","borderRadius":"20dp","borderWidth":"1dp","borderColor":"#557BC7FF","items":[
            {"type":"Container","height":"100%","paddingLeft":"${viewport.width >= 600 ? '18dp' : '11dp'}","paddingRight":"10dp","paddingTop":"${viewport.height >= 500 ? '15dp' : '9dp'}","paddingBottom":"${viewport.height >= 500 ? '13dp' : '8dp'}","justifyContent":"spaceBetween","items":[
              {"type":"Text","text":"⌁  RED","fontSize":"${viewport.height >= 500 ? '13dp' : '9dp'}","fontWeight":"bold","color":"#80CBFF","maxLines":1},
              {"type":"Text","text":"${MiSolarData && MiSolarData.red ? MiSolarData.red : '--'}","fontSize":"${viewport.height >= 500 ? '45dp' : '29dp'}","fontWeight":"bold","color":"#FFFFFF","maxLines":1},
              {"type":"Text","text":"${MiSolarData && MiSolarData.redDireccion ? MiSolarData.redDireccion : 'INTERCAMBIO ACTUAL'}","fontSize":"${viewport.height >= 500 ? '10dp' : '7dp'}","color":"#BCD4E5","maxLines":1}
            ]}
          ]}
        ]},
        {"type":"Frame","height":"${viewport.height >= 500 ? '92dp' : '62dp'}","backgroundColor":"#F0182D3D","borderRadius":"20dp","borderWidth":"1dp","borderColor":"#557AA0B7","items":[
          {"type":"Container","height":"100%","paddingLeft":"${viewport.width >= 600 ? '18dp' : '11dp'}","paddingRight":"${viewport.width >= 600 ? '18dp' : '11dp'}","paddingTop":"${viewport.height >= 500 ? '12dp' : '8dp'}","paddingBottom":"${viewport.height >= 500 ? '10dp' : '7dp'}","justifyContent":"spaceBetween","items":[
            {"type":"Container","direction":"row","justifyContent":"spaceBetween","items":[
              {"type":"Text","text":"${'GENERADO  ' + (MiSolarData && MiSolarData.generadoHoy ? MiSolarData.generadoHoy : '--')}","fontSize":"${viewport.height >= 500 ? '14dp' : '10dp'}","fontWeight":"bold","color":"#FFE16A","maxLines":1},
              {"type":"Text","text":"${MiSolarData && MiSolarData.tienePronostico ? 'ESPERADO  ' + MiSolarData.esperadoHoy : 'ESPERADO  --'}","fontSize":"${viewport.height >= 500 ? '13dp' : '9dp'}","fontWeight":"bold","color":"#FFFFFF","maxLines":1}
            ]},
            {"type":"Frame","width":"100%","height":"${viewport.height >= 500 ? '18dp' : '12dp'}","backgroundColor":"#35536B78","borderRadius":"9dp","items":[{"type":"Frame","width":"${MiSolarData && MiSolarData.progresoSolarValor ? MiSolarData.progresoSolarValor + '%' : '0%'}","height":"100%","backgroundColor":"#FFD84F","borderRadius":"9dp"}]},
            {"type":"Text","text":"${MiSolarData && MiSolarData.progresoSolar ? MiSolarData.progresoSolar + ' de la meta diaria' : 'Esperando datos de producción'}","fontSize":"${viewport.height >= 500 ? '10dp' : '7dp'}","color":"#BBD2DE","maxLines":1}
          ]}
        ]},
        {"type":"Text","height":"${viewport.height >= 500 ? '22dp' : '15dp'}","text":"${(MiSolarData && MiSolarData.estado ? MiSolarData.estado : 'Sin datos') + ' · ' + (MiSolarData && MiSolarData.hora ? MiSolarData.hora : '--:--') + ' · widget v1.0.7'}","fontSize":"${viewport.height >= 500 ? '9dp' : '7dp'}","color":"#AFC5D1","textAlign":"center","textAlignVertical":"center","maxLines":1}
      ]}
    ]
  }]}
}
